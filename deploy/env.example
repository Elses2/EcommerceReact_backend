# Ejemplo de variables para el despliegue (SPEC §16 y §21.6).
# IMPORTANTE: copiar este archivo a .env (en la raíz del deploy) y completar con
# valores REALES. Nunca commitear el .env real.
#   cp deploy/env.example .env
# Referencia: spectsEccomerce/SPEC.md §16.

# ── Obligatorias en producción ───────────────────────────────────────────────
# Secreto de firma de los JWT (spec §23.1). Mínimo 32 caracteres.
# Generar con: openssl rand -hex 48
JWT_SECRET=CAMBIAR_ESTO_POR_UN_SECRETO_LARGO_Y_ALEATORIO

# Password de Redis. El compose arma REDIS_URL con este valor.
# Generar con: openssl rand -hex 24
REDIS_PASSWORD=CAMBIAR_ESTO

# ── Opcionales (defaults en código, spec §16) ───────────────────────────────
# Vida del access token JWT (formato de jsonwebtoken).
JWT_EXPIRES_IN=2h

# Cookie Secure (spec §23.1): true SOLO detrás de HTTPS. Con HTTP dejar false.
COOKIE_SECURE=false

# CSP (spec §22.2): true SOLO detrás de HTTPS.
CSP_UPGRADE_INSECURE=false

# Imagen fallback de productos.
FALLBACK_IMAGE_URL=https://placehold.co/600x600?text=Sin+imagen

# Puerto interno del backend (el compose lo fija en 3000; no cambiar sin ajustar el healthcheck).
PORT=3000

# Ruta de la base SQLite dentro del contenedor (la fija el compose: /data/shop.db).
DB_PATH=/data/shop.db

# NOTA: REDIS_URL no se define aquí: docker-compose.example.yml la arma como
# redis://:<REDIS_PASSWORD>@redis:6379 dentro de la red del compose.
